# Backend endpoints. Unset means the production prod-v2 API (see src/configuration/config.js).
# For the dev backend, copy the crest-api-dev stack outputs into .env.local.
VITE_API_IDENTIFY_URL=
VITE_API_ZONAL_STATS_URL=
VITE_API_UPLOAD_SHAPE_URL=
VITE_API_SHARE_READ_URL=
VITE_API_SHARE_WRITE_URL=
# dev shows the refreshed North Atlantic data
VITE_CREST_DATA_CHANNEL=dev
