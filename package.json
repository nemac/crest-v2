    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "maplibre-gl": "^6.9.0",
    "pmtiles": "^4.5.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-redux": "^7.2.9",
    "react-router-dom": "^6.14.1",
    "recharts": "^2.11.0",
    "shpjs": "^4.0.4",
    "terra-draw": "^1.33.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "uuid": "^11.1.1"
