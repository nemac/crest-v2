{
  "name": "crest_v2",
  "version": "1.0.0",
  "author": "nemac",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "check": "prettier --check \"**/*.{js,jsx,json,yml,yaml}\" && npm run lint && npm test",
    "dev": "VITE_CREST_DATA_CHANNEL=dev vite --port 8080",
    "fixlint": "eslint . --report-unused-disable-directives --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,yml,yaml}\"",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "vite --port 8080",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-redux": "^4.2.2",
    "globals": "^17.13.0",
    "prettier": "^3.2.5",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "dependencies": {
